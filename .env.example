# Optional. You can also paste keys in Plazai's Settings channel (stored only in your browser).
# Any one is enough. Without a key, Plazai runs in demo mode with scripted agents.
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free and fully local: install Ollama (https://ollama.com) and pull a model, e.g. `ollama pull llama3.2`
OLLAMA_BASE_URL=http://127.0.0.1:11434
